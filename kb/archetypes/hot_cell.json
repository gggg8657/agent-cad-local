   "unit": "mm",
   "range": [
    1500,
    8000
   ]
  },
  "cell_D": {
   "v": 3000,
   "label": "셀 내부 깊이",
   "unit": "mm",
   "range": [
    1500,
    8000
   ]
  },
  "cell_H": {
   "v": 4000,
   "label": "셀 내부 높이",
   "unit": "mm",
   "range": [
    2500,
    8000
   ]
  },
  "wall_t": {
   "v": 1000,
   "label": "차폐벽 두께 (콘크리트)",
   "unit": "mm",
   "range": [
    300,
    2000
   ]
  },
  "n_manip": {
   "v": 2,
   "label": "셀당 매니퓰레이터",
   "unit": "대",
   "range": [
    1,
    4
   ]
  }
 },
 "sizing": {
  "pitch": "cell_W + wall_t",
  "row_L": "n_cell * pitch + wall_t"
 },
 "components": [
  {
   "id": "cell",
   "type": "cell",
   "count": "n_cell",
   "size": {
    "W": "cell_W + 2 * wall_t",
    "L": "cell_D + 2 * wall_t",
    "H": "cell_H + wall_t",
    "t": "wall_t"
   },
   "place": {
    "line": {
     "pitch": "pitch",
     "z": "0",
     "dir": "x"
    }
   }
  },
  {
   "id": "win",
   "type": "window",
   "count": "n_cell",
   "size": {
    "W": "min(1200, cell_W * 0.35)",
    "L": "wall_t + 40",
    "H": "900"
   },
   "place": {
    "line": {
     "pitch": "pitch",
     "z": "wall_t + 1200",
     "dir": "x",
     "cy": "-(cell_D + wall_t) / 2"
    }
   }
  },
  {
   "id": "manip",
   "type": "manipulator",
   "count": "n_cell * n_manip",
   "size": {
    "D": "200",
    "H": "wall_t + 1800",
    "axis": "y"
   },
   "place": {
    "line": {
     "pitch": "pitch",
     "per": "n_manip",
     "offsets": "cell_W * 0.32",
     "z": "wall_t + 2300",
     "dir": "x",
     "cy": "-(cell_D + wall_t) / 2 - 900"
    }
   }
  },
  {
   "id": "crane",
   "type": "crane",
   "size": {
    "W": "row_L",
    "L": "600",
    "H": "500"
   },
   "place": {
    "at": {
     "z": "cell_top + 1500"
    }
   }
  }
 ],
 "connections": [],
 "loops": [
  {
   "key": "ventilation",
   "name": "배기 (음압 유지)",
   "path": [
    "cell",
    "HEPA"
   ]
  }
 ],
 "principles": [
